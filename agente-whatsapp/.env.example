# Copie este arquivo para `.env` (mesma pasta) e preencha os valores.
# O `instalar.command` faz essa cópia sozinho na primeira vez.
#
# NUNCA coloque valor de verdade AQUI: este arquivo vai para o repositório.
# O segredo mora só no `.env`, que fica de fora.

# Endereço do seu Raro.ia, sem barra no fim. Precisa ser https://
BASE_URL=

# A mesma senha configurada no servidor (variável RARO_AGENTE_SEGREDO na Vercel).
# Mínimo de 12 caracteres. Se os dois lados não forem idênticos, nada passa.
RARO_AGENTE_SEGREDO=

# Quantos dias de conversa antiga varrer quando o WhatsApp reconecta.
# Padrão 7, máximo 30. Só vale na primeira vez: depois o agente lembra
# até onde já leu e não repete a semana inteira.
DIAS_HISTORICO=

# --- Daqui para baixo é opcional. Deixe em branco para usar o padrão. ---

# Onde guardar a sessão do WhatsApp e as filas.
# Padrão: ~/Library/Application Support/RaroAgenteWhatsApp
PASTA_DADOS=

# De quantos em quantos segundos cada tarefa roda.
SEGUNDOS_ENTRE_LOTES=
SEGUNDOS_ENTRE_FILA=
SEGUNDOS_ENTRE_PULSOS=

# Quantas mensagens por requisição ao servidor.
TAMANHO_DO_LOTE=
